# Important ALTER TABLE Commands

```sql
-- Add a column
ALTER TABLE student
ADD Email VARCHAR(100);

-- Add multiple columns
ALTER TABLE student
ADD (
    Age INT,
    City VARCHAR(30)
);

-- Drop a column
ALTER TABLE student
DROP COLUMN City;

-- Modify a column
ALTER TABLE student
MODIFY Age TINYINT;

-- Rename a column
ALTER TABLE student
RENAME COLUMN Age TO Student_Age;

-- Add UNIQUE constraint
ALTER TABLE student
ADD CONSTRAINT unique_email UNIQUE (Email);

-- Add PRIMARY KEY
ALTER TABLE student
ADD PRIMARY KEY (Roll_No);

-- Add FOREIGN KEY
ALTER TABLE employee
ADD CONSTRAINT fk_department
FOREIGN KEY (DEPT_ID)
REFERENCES department(ID);

-- Add CHECK constraint
ALTER TABLE student
ADD CONSTRAINT chk_age CHECK (Student_Age >= 18);
```

